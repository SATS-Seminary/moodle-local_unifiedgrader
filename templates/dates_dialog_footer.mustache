{{!
    @template local_unifiedgrader/dates_dialog_footer

    Footer of the "Dates & extensions" dialogue. It stays in view while the body scrolls.

    Example context (json):
    {
        "canremoveall": true,
        "hasany": true,
        "summary": "2 changes for Stu Dent",
        "changes": true
    }
}}
<div class="ug-dates-footer">
    {{#canremoveall}}
    <button type="button" class="btn btn-link ug-dates-removeall" data-action="removeall"{{^hasany}} disabled{{/hasany}}>
        {{#str}} dates_remove_all, local_unifiedgrader {{/str}}
    </button>
    {{/canremoveall}}
    <span class="ug-dates-summary" data-region="summary" aria-live="polite">{{summary}}</span>
    <button type="button" class="btn btn-secondary" data-action="cancel">{{#str}} cancel {{/str}}</button>
    <button type="button" class="btn btn-primary" data-action="save"{{^changes}} disabled{{/changes}}>{{#str}} save {{/str}}</button>
</div>
