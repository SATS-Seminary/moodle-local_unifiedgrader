{{!
    @template local_unifiedgrader/settings_index

    The Unified Grader's settings index: one tile per settings page.

    Context variables required for this template:
    * tiles - array - One per page: key, title, description, icon (a Font
      Awesome class), url

    Example context (json):
    {
        "tiles": [
            {
                "key": "general",
                "title": "General",
                "description": "Which activities use the Unified Grader, and how it grades.",
                "icon": "fa-sliders",
                "url": "https://example.com/admin/settings.php?section=local_unifiedgrader"
            }
        ]
    }
}}
<div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-3 mt-1" data-region="unifiedgrader-settings-index">
    {{#tiles}}
    <div class="col">
        <div class="card h-100 ug-settings-tile" data-tile="{{key}}">
            <div class="card-body d-flex gap-3">
                <i class="fa {{icon}} fa-2x fa-fw text-primary mt-1" aria-hidden="true"></i>
                <div>
                    <h3 class="h5 card-title mb-1">
                        <a href="{{url}}" class="stretched-link text-decoration-none">{{title}}</a>
                    </h3>
                    <p class="card-text text-muted small mb-0">{{description}}</p>
                </div>
            </div>
        </div>
    </div>
    {{/tiles}}
</div>
